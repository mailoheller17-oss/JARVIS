# Jarvis – Umgebungsvariablen. NIE echte Schlüssel committen!
# In Codespaces am besten als Secret: github.com/settings/codespaces → Secrets
# Kosten: gratis | gratis-kontingent | kostenpflichtig (kostenpflichtige sind in der App standardmäßig AUS)

# --- App ---
# Zugangs-Token für die Web-App (sonst Dev-Token beim Start)
JARVIS_WEB_TOKEN=
# Standard-Ort fürs Wetter
JARVIS_ORT=Berlin

# --- Sprache ---
# Edge-TTS (gratis) – https://github.com/rany2/edge-tts
#   kein Schlüssel nötig
# ElevenLabs (gratis-kontingent) – https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Whisper (lokal) (gratis) – https://github.com/SYSTRAN/faster-whisper
#   kein Schlüssel nötig

# --- KI-Text ---
# Ollama (lokal) (gratis) – https://ollama.com/download
#   kein Schlüssel nötig
# Gemini (gratis-kontingent) – https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (gratis-kontingent) – https://console.groq.com/keys
GROQ_API_KEY=
# Cerebras (gratis-kontingent) – https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# OpenRouter (gratis-kontingent) – https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral (gratis-kontingent) – https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# SambaNova (gratis-kontingent) – https://cloud.sambanova.ai/apis
SAMBANOVA_API_KEY=
# NVIDIA NIM (gratis-kontingent) – https://build.nvidia.com/
NVIDIA_API_KEY=
# Hugging Face (Text) (gratis-kontingent) – https://huggingface.co/settings/tokens
HF_TOKEN=
# Claude Code CLI (kostenpflichtig) – https://docs.claude.com/en/docs/claude-code/setup
#   kein Schlüssel nötig

# --- Bilder ---
# Gemini-Bild: nutzt GEMINI_API_KEY (siehe oben)
# Hugging Face FLUX: nutzt HF_TOKEN (siehe oben)
# Pollinations (gratis) – https://pollinations.ai
#   kein Schlüssel nötig

# --- Video-KI ---
# Higgsfield (kostenpflichtig) – https://cloud.higgsfield.ai/
HIGGSFIELD_API_KEY=
# Luma Dream Machine (kostenpflichtig) – https://lumalabs.ai/dream-machine/api/keys
LUMAAI_API_KEY=
# Runway (kostenpflichtig) – https://dev.runwayml.com/
RUNWAYML_API_SECRET=

# --- Material ---
# Freesound (gratis) – https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=
# Mixkit (gratis) – https://mixkit.co/
#   kein Schlüssel nötig
# Pexels (gratis) – https://www.pexels.com/api/new/
PEXELS_API_KEY=
# Pixabay (gratis) – https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- Wissen ---
# DuckDuckGo (gratis) – https://duckduckgo.com
#   kein Schlüssel nötig
# Google Trends (gratis) – https://trends.google.com/trending?geo=DE
#   kein Schlüssel nötig
# Wikipedia (gratis) – https://de.wikipedia.org
#   kein Schlüssel nötig

# --- Übersetzen ---
# DeepL Free (gratis-kontingent) – https://www.deepl.com/de/pro-api
DEEPL_API_KEY=

# --- Alltag ---
# Kalender (ICS) (gratis) – https://support.google.com/calendar/answer/37648
KALENDER_ICS_URL=
# Wetter (Open-Meteo) (gratis) – https://open-meteo.com
#   kein Schlüssel nötig

# --- Messenger ---
# Discord-Webhook (gratis) – https://support.discord.com/hc/de/articles/228383668
DISCORD_WEBHOOK_URL=
# Telegram (gratis) – https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# --- Entwickler ---
# GitHub (gratis) – https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Optional: Modelle/Stimmen überschreiben ---
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OLLAMA_MODEL=llama3.2
# ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# EDGE_TTS_VOICE=de-DE-ConradNeural
# TELEGRAM_CHAT_ID=   (deine Chat-ID, für Nachrichten an dich)
