# JARVIS .env.example
# WICHTIG: Keine echten Werte eintragen. Nur Schlüssel-Namen, mit kurzer Info.
# 
# Nicht lesen: Das Projekt darf .env nicht lesen; nur der lokale Server oder die
# Laufzeitumgebung soll diese Werte erhalten. Der Code soll .env.example als Referenz verwenden.

# Gemini API
# Holen: https://ai.google.dev/gemini-api
GEMINI_API_KEY=

# OpenAI-compatible APIs (z.B. Groq, OpenRouter, NVIDIA, Cerebras, SambaNova, Mistral)
# Holen: je nach Anbieter, z.B. https://console.groq.com/keys
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
HUGGINGFACE_API_KEY=

# Claude Code CLI
# Wenn installiert, setzt das CLI den Zugriff lokal. Keine Token hier eintragen.
CLAUDE_CODE_ENABLED=false

# Telegram Bot
# Holen: https://core.telegram.org/bots#creating-a-new-bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web-App / Tailscale
WEB_APP_SECRET=
APP_BASE_URL=http://127.0.0.1:8000

# Media / local tools
FFMPEG_PATH=ffmpeg
WHISPER_MODEL=base
MATERIAL_INPUT_DIR=input/eigene_clips
OUTPUT_DIR=output
CAR_EDIT_OUTPUT_DIR=output/car_edits

# Logging / local runtime
JARVIS_HOME=.
LOG_LEVEL=INFO
